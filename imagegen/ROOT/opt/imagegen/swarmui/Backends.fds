# One backend: the ComfyUI that vast's image runs under supervisor. AllowIdle lets the
# backend wait (rather than fail for good) while ComfyUI is starting or restarting.
0:
    type: comfyui_api
    title: ComfyUI on this instance
    enabled: true
    settings:
        Address: http://127.0.0.1:18188
        AllowIdle: true
        OverQueue: 1
        EnableFrontendDev: false
