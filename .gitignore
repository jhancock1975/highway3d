# secrets (the vast.ai API key lives in .env) -- never committed; a local
# pre-commit hook also refuses any commit carrying a value from .env
.env
.env.*
!.env.example

# generated video, stills and audio -- this project's output is binary and
# large, and none of it belongs in git. 378 MB of unreachable WAV objects
# were sitting in the pack from staging that never reached a commit.
renders/
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.png
*.jpg
*.jpeg
*.gif
*.wav
*.mp3
*.aac
*.flac

# downloaded CC0 assets, refetched by highway3d/setup.sh
assets/

# python
.venv/
.ttsvenv/
.mcpvenv/
.manimvenv/
.musicvenv/
__pycache__/
*.pyc

# editor leftovers
*~

# intermediate per-segment scratch
.work/

# 3D assets and model weights -- fetched or generated, never authored here
*.blend
*.blend[0-9]*
*.glb
*.gltf
*.fbx
*.obj
*.exr
*.hdr
*.pt
*.pth
*.ckpt
*.safetensors

# compiled objects and archives
*.so
*.dylib
*.dll
*.o
*.a
*.zip
*.tar
*.tar.gz
*.tgz

# python packaging and any vendored library tree
site-packages/
node_modules/
*.egg-info/
*.whl
build/
dist/

# macOS
.DS_Store

# project-local Blender user dir: MPFB + MakeHuman packs, built by
# lectern/presenter/setup_human.sh
lectern/.blender/

# fonts are fetched by fonts.py into .work/fonts, never committed
*.ttf
*.otf
*.ttc
*.woff
*.woff2
